# Copy to .env and fill in. NEVER commit .env — it holds a private key.
# All wallets here are TEST-ONLY. Use a fresh throwaway wallet, never a real one.

# Aevum testnet RPC (public)
AEVUM_RPC_URL=https://rpc-test.qday.info

# Deployer / merchant wallet (fresh test-only key, 0x-prefixed). Fund it from the
# QDay Discord faucet: /faucet <address>  (1 tQDAY + 5 tUSD8, once per Discord account).
# The web faucet does NOT work for fresh wallets (it requires mainnet ETH/USDT/USDC).
DEPLOYER_KEY=
MERCHANT_KEY=
BUYER_KEY=
RELAYER_KEY=

# Deployed contract addresses (filled by scripts/deploy.mjs into deployments/<chainId>.json)
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483
PAYLINK_ADDRESS=
